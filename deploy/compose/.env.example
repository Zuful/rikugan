# Copy to .env next to compose.yaml and fill in.

# The Compose project whose services rikugan serve watches.
WATCHED_PROJECT=myapp
PROMETHEUS_URL=http://prometheus:9090

# Bearer token of the verdicts API (get_watch_reports sends it):
#   openssl rand -hex 24
RIKUGAN_SERVE_TOKEN=

# Notifications: Telegram and/or Slack.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# Optional
# ALERTMANAGER_URL=http://alertmanager:9093
# RIKUGAN_COMPOSE_ROLLOUT_DEADLINE=10m
# RIKUGAN_SERVE_PORT=8080
