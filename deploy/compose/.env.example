# Copy to .env next to compose.yaml and fill in.

# The Compose project whose services rikugan serve watches.
WATCHED_PROJECT=myapp
PROMETHEUS_URL=http://prometheus:9090

# Bearer token of the verdicts API (get_watch_reports sends it):
#   openssl rand -hex 24
RIKUGAN_SERVE_TOKEN=

# Notifications: Telegram and/or Slack.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
# Or a Slack bot, which can answer in threads (instead of the webhook):
# SLACK_BOT_TOKEN=xoxb-…
# SLACK_CHANNEL=C…

# Optional
# Dead man's switch: a URL pinged every RIKUGAN_HEARTBEAT_INTERVAL (5m)
# while the daemon runs (a healthchecks.io check, an Uptime Kuma push
# monitor). It alerts when the pings stop: a stopped daemon is silent.
# RIKUGAN_HEARTBEAT_URL=https://hc-ping.com/<uuid>
# RIKUGAN_HEARTBEAT_INTERVAL=5m
# ALERTMANAGER_URL=http://alertmanager:9093
# RIKUGAN_COMPOSE_ROLLOUT_DEADLINE=10m
# RIKUGAN_SERVE_PORT=8080
