# The lab's settings. ./lab.sh up copies this file to .env and fills in
# RIKUGAN_SERVE_TOKEN; edit .env, then ./lab.sh up again to apply.

# Where rikugan sends its messages. Create a bot with @BotFather, send
# it a message, and read your chat id from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL=

# Optional dead man's switch, e.g. a healthchecks.io ping URL.
# RIKUGAN_HEARTBEAT_URL=

# Mean requests per second (./lab.sh traffic changes them). low's 0.17
# is about 10 requests a minute.
LAB_WEB_RPS=20
LAB_API_RPS=3
LAB_LOW_RPS=0.17
# Traffic shape: a daily cycle of ±50 % peaking at 14:00 UTC, and a
# 90-second burst at three times the rate every 3 hours on average.
LAB_CYCLE=24h
LAB_AMPLITUDE=0.5
LAB_PEAK_AT=14h
LAB_BURST_EVERY=3h
LAB_BURST_LENGTH=90s

# Background noise of web, api and low: 0.2 % of sporadic 5xx, 1 % of
# requests 250 ms slower, a 150 ms pause every 2 minutes.
LAB_NOISE_ERROR_RATE=0.002
LAB_TAIL_SHARE=0.01
LAB_TAIL_MS=250
LAB_PAUSE_EVERY=2m
LAB_PAUSE_MS=150

# Memory limit of each shop replica. The leak scenario fills it in
# about 11 h at 768m; lower it on a small host.
LAB_MEM_LIMIT=768m

# rikugan: how long a Compose rollout may take before it is failed, and
# how often every service is swept (the design's default is 4h).
RIKUGAN_COMPOSE_ROLLOUT_DEADLINE=5m
RIKUGAN_SWEEP_INTERVAL=1h

# Host ports, on 127.0.0.1 only.
LAB_PROMETHEUS_PORT=9090
LAB_RIKUGAN_PORT=8080

RIKUGAN_SERVE_TOKEN=

# Escalation: an OpenCode agent investigates each critical, on a local
# model through Ollama (README.md, section 7). Needs a notification
# channel above.
LAB_ESCALATION=off
LAB_OLLAMA_MODEL=gemma4:12b-it-qat
LAB_OLLAMA_URL=http://host.docker.internal:11434/v1
# Another provider instead: its OpenCode name, as provider/model, with
# its API key in escalation.env (README.md, section 7). Empty: Ollama.
LAB_MODEL=
RIKUGAN_ESCALATION_TIMEOUT=30m
RIKUGAN_ESCALATION_MONTHLY_BUDGET=1000
