# The lab's settings. ./lab.sh up copies this file to .env and fills in
# RIKUGAN_SERVE_TOKEN; edit .env, then ./lab.sh up again to apply.

# Where rikugan sends its messages. Create a bot with @BotFather, send
# it a message, and read your chat id from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=

# Optional dead man's switch, e.g. a healthchecks.io ping URL.
# RIKUGAN_HEARTBEAT_URL=

# Mean requests per second (./lab.sh traffic changes them).
LAB_WEB_RPS=20
LAB_API_RPS=3
# Traffic shape: a daily sine of ±50 %, and a 5-minute burst at three
# times the rate every 6 hours on average.
LAB_CYCLE=24h
LAB_AMPLITUDE=0.5
LAB_BURST_EVERY=6h

# Memory limit of each shop replica. The leak scenario fills it in
# about 11 h at 768m; lower it on a small host.
LAB_MEM_LIMIT=768m

# rikugan: how long a Compose rollout may take before it is failed, and
# how often every service is swept (the design's default is 4h).
RIKUGAN_COMPOSE_ROLLOUT_DEADLINE=5m
RIKUGAN_SWEEP_INTERVAL=1h

# Host ports, on 127.0.0.1 only.
LAB_PROMETHEUS_PORT=9090
LAB_RIKUGAN_PORT=8080

RIKUGAN_SERVE_TOKEN=
