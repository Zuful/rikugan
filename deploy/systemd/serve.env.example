# /etc/rikugan/serve.env, read by rikugan-serve.service.

# Orchestration backend: kubernetes (with KUBECONFIG readable by the
# rikugan user) or dockercompose (with the docker group, see the unit).
ORCHESTRATION_PROVIDER=dockercompose
COMPOSE_PROJECT_NAME=myapp
# KUBECONFIG=/etc/rikugan/kubeconfig
# RIKUGAN_SERVE_NAMESPACES=shop,payments

PROMETHEUS_URL=http://127.0.0.1:9090

# Verdicts API: loopback needs no token; anything else does.
RIKUGAN_SERVE_LISTEN=127.0.0.1:8080
# RIKUGAN_SERVE_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=

# Dead man's switch: a URL pinged every RIKUGAN_HEARTBEAT_INTERVAL (5m)
# while the daemon runs (a healthchecks.io check, an Uptime Kuma push
# monitor). It alerts when the pings stop: a stopped daemon is silent.
# RIKUGAN_HEARTBEAT_URL=https://hc-ping.com/<uuid>
# RIKUGAN_HEARTBEAT_INTERVAL=5m
